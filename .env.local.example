# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys here.

# Clerk publishable key (frontend). Get it from the Clerk dashboard:
# https://dashboard.clerk.com -> your app -> API Keys -> Publishable key.
# Same value as the VITE_CLERK_PUBLISHABLE_KEY GitHub Actions variable used for production builds.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL for recipe images stored in the Cloudflare R2 bucket.
# Only needed if you're serving images from a custom domain/public R2 bucket URL;
# leave blank for local dev if you aren't testing image uploads.
VITE_R2_BASE_URL=https://your-r2-public-domain.example.com
